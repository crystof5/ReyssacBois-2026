## Exemple de configuration (à copier en .env.local)
## Ne jamais committer vos vraies clés (.env* est ignoré par git).

## reCAPTCHA v3 (Google)
# Clé "site" (publique) — visible côté navigateur
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Clé "secret" (privée) — uniquement côté serveur
RECAPTCHA_SECRET_KEY=

# Score minimum reCAPTCHA v3 (0.0 à 1.0). 0.5 est un bon départ.
RECAPTCHA_MIN_SCORE=0.5

# (Optionnel mais recommandé) Hostnames autorisés renvoyés par Google.
# Mets ici tes domaines déclarés dans la console reCAPTCHA (sans protocole).
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,reyssacbois.fr,www.reyssacbois.fr

## Email (formulaire de contact via SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Destinataires
CONTACT_TO=
CONTACT_CC=

# Personnalisation
CONTACT_FROM_NAME=Site ReyssacBois
CONTACT_SUBJECT_PREFIX=Site ReyssacBois

## SEO / URL canonique du site (recommandé)
# Ex: https://reyssacbois.fr
NEXT_PUBLIC_SITE_URL=

## Base de données (Prisma)
# DATABASE_URL : URL utilisée par l'app (souvent pooler en prod)
# DIRECT_URL   : URL directe (recommandée pour migrations / dev si pooler limité)
DATABASE_URL=
DIRECT_URL=

# (Optionnel) si tu préfères nommer explicitement Neon, l'app accepte aussi :
DATABASE_URL_NEON=
DIRECT_URL_NEON=

## Auth admin (en base via Prisma)
# Utilisé par `prisma db seed` pour créer / mettre à jour l'admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

## Cloudflare R2 (S3 compatible) — stockage images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Base publique utilisée pour générer les URLs (r2.dev ou domaine custom).
# Ex: https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=

